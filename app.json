{
  "expo": {
    "name": "One Thing",
    "slug": "one-thing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onething",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onething.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.onething.app",
      "permissions": [
        "android.permission.health.READ_SLEEP",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#2F5D46",
          "defaultChannel": "one-thing"
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "One Thing reads last night’s sleep to size today’s work block.",
          "healthUpdatePermission": "One Thing does not write health data."
        }
      ],
      "react-native-health-connect",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow One Thing to turn your voice into task text.",
          "speechRecognitionPermission": "Allow One Thing to recognize the words you dictate."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-mail-composer",
      "expo-localization",
      "@sentry/react-native",
      "./plugins/with-android-single-top"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
